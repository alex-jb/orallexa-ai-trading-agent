# ── Required ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Required to start the API outside demo mode. Use a unique random secret.
# Send it as X-API-Key for protected broker and paid-model endpoints.
# Keep it out of NEXT_PUBLIC_* variables and the browser bundle.
ORALLEXA_API_KEY=
# Optional owner-only Next.js bridge (set on the Next.js SERVER at runtime,
# with the same ORALLEXA_API_KEY as the FastAPI server):
# ORALLEXA_UI_OWNER_TOKEN=generate-with-openssl-rand-hex-32
# ORALLEXA_UI_ORIGIN=https://your-frontend.example
# ORALLEXA_SERVER_API_URL=https://your-api.example
# Paper submission is off by default; enable only after the mandatory
# broker-sourced portfolio gate in PR #20 is integrated and verified.
# ORALLEXA_ENABLE_PAPER_UI=1
# For a private, local-only HTTP API upstream, explicitly allow HTTP:
# ORALLEXA_ALLOW_HTTP_UPSTREAM=1

# Optional public demo: protected endpoints, including all paper orders, are disabled.
# DEMO_MODE=1

# ── Optional: Desktop Agent (voice/TTS) ──
OPENAI_API_KEY=sk-your-key-here

# ── Optional: Alpaca Paper Trading (free) ──
# Get keys at https://app.alpaca.markets → Settings → API Keys
ALPACA_API_KEY=PK-your-key-here
ALPACA_SECRET_KEY=your-secret-here

# ── Optional: Cloud Deployment ───────────
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ── Optional: Defaults ───────────────────
# BULL_TICKER=NVDA
# BULL_MODE=intraday
# BULL_TF=15m
