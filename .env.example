# ── Required ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Required to start the API outside demo mode. Use a unique random secret.
# Send it as X-API-Key for protected broker and paid-model endpoints.
# Keep it out of NEXT_PUBLIC_* variables and the browser bundle.
ORALLEXA_API_KEY=
# Server-side paid LLM admission budget, reset on Mondays 00:00 UTC.
# Default is $5/week if unset. Set to 0 to block all paid model calls.
ORALLEXA_WEEKLY_LLM_BUDGET_USD=5.00
# Persist this SQLite path on a shared volume when running multiple API workers.
# ORALLEXA_WEEKLY_LLM_BUDGET_DB=logs/weekly_llm_budget.sqlite3

# Optional public demo: protected endpoints, including all paper orders, are disabled.
# DEMO_MODE=1

# ── Optional: Desktop Agent (voice/TTS) ──
OPENAI_API_KEY=sk-your-key-here

# ── Optional: Alpaca Paper Trading (free) ──
# Get keys at https://app.alpaca.markets → Settings → API Keys
ALPACA_API_KEY=PK-your-key-here
ALPACA_SECRET_KEY=your-secret-here

# ── Optional: Cloud Deployment ───────────
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ── Optional: Defaults ───────────────────
# BULL_TICKER=NVDA
# BULL_MODE=intraday
# BULL_TF=15m
