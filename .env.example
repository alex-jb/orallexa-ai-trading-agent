# ── Required ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# Required to start the API outside demo mode. Use a unique random secret.
# Send it as X-API-Key for protected endpoints. Keep it out of the frontend bundle.
ORALLEXA_API_KEY=

# Optional public demo: protected endpoints, including all paper orders, are disabled.
# DEMO_MODE=1

# ── Optional: Desktop Agent (voice/TTS) ──
OPENAI_API_KEY=sk-your-key-here

# ── Optional: Alpaca Paper Trading (free) ──
# Get keys at https://app.alpaca.markets → Settings → API Keys
ALPACA_API_KEY=PK-your-key-here
ALPACA_SECRET_KEY=your-secret-here

# ── Optional: Cloud Deployment ───────────
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# NEXT_PUBLIC_API_URL=https://your-api.railway.app

# ── Optional: Defaults ───────────────────
# BULL_TICKER=NVDA
# BULL_MODE=intraday
# BULL_TF=15m
