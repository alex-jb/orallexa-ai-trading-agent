<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.alexji.orallexa-paper-daily.plist
  ─────────────────────────────────────────────────────────────────
  Legacy technical-decision log only: no Alpaca orders and no LLM calls.
  The schedule is 6:35 AM in the computer's local timezone. On a Pacific
  timezone machine this is ordinarily 9:35 AM Eastern. Adjust the calendar
  fields for other machine timezones. This is not the fixed-rule paper loop.

  Install:
    cp scripts/launchd/com.alexji.orallexa-paper-daily.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.alexji.orallexa-paper-daily.plist
    launchctl list | grep orallexa-paper-daily   # verify

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.alexji.orallexa-paper-daily.plist
    rm ~/Library/LaunchAgents/com.alexji.orallexa-paper-daily.plist

  Edit the bounded watchlist using the ticker-list argument.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexji.orallexa-paper-daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>cd $HOME/Desktop/orallexa-ai-trading-agent &amp;&amp; mkdir -p logs &amp;&amp; /usr/bin/env python3 scripts/run_daily_pilot.py --dry-run --out logs/pilot.jsonl</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>35</integer>
        <key>Weekday</key>
        <array>
            <dict><key>Weekday</key><integer>1</integer></dict>
            <dict><key>Weekday</key><integer>2</integer></dict>
            <dict><key>Weekday</key><integer>3</integer></dict>
            <dict><key>Weekday</key><integer>4</integer></dict>
            <dict><key>Weekday</key><integer>5</integer></dict>
        </array>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/alexji/Desktop/orallexa-ai-trading-agent/logs/pilot.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/alexji/Desktop/orallexa-ai-trading-agent/logs/pilot.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
